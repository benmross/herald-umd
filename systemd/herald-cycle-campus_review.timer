[Unit]
Description=Herald — model review of scraped campus events

[Timer]
# Every six hours. A run with nothing new makes no model call, so the cadence
# only bounds how long a new event waits off the calendar for its verdict.
OnCalendar=*-*-* 01,07,13,19:45:00
Persistent=true
RandomizedDelaySec=300
AccuracySec=2min
Unit=herald-cycle@campus_review.service

[Install]
WantedBy=timers.target
